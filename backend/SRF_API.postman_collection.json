        {
          "name": "Create Order (Sell)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('order_id', jsonData.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"sell order\",\n  \"items\": [\n    {\n      \"item\": \"{{item_id}}\",\n      \"quantity\": 5\n    }\n  ],\n  \"customerName\": \"{{customer_id}}\",\n  \"cargo\": \"{{cargo_id}}\",\n  \"status\": \"pending\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/orders",
              "host": ["{{base_url}}"],
              "path": ["api", "orders"]
            },
            "description": "Create a new sell order by Admin. Each item must include 'item' (ID) and 'quantity' (number). The system will check if sufficient quantity is available and deduct from inventory. The createdBy field is automatically set to 'Admin'. Use admin_token in Authorization header."
          },
          "response": []
        },
        {
          "name": "Create Order (Purchase)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"purchase order\",\n  \"items\": [\n    {\n      \"item\": \"{{item_id}}\",\n      \"quantity\": 10\n    }\n  ],\n  \"status\": \"pending\"\n}"
